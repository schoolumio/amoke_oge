---
import BaseLayout from '../layouts/BaseLayout.astro';
import { photos } from '../data/photos';

const list = Object.values(photos).filter((p) => p.credit);
---
<BaseLayout title="Photo Credits | Amoke Oge" description="Credits and licences for the photography used on the Amoke Oge website.">
  <section class="section">
    <div class="container credits">
      <p class="eyebrow">Photo credits</p>
      <h1 class="h2" style="margin-top:1rem">Photography &amp; <em class="accent">licences</em></h1>
      <p class="lede" style="margin-top:1.25rem">
        The food photography on this website concept is demonstration imagery of Nigerian dishes, sourced from
        Wikimedia Commons under Creative Commons licences. These are not photographs of Amoke Oge’s food or
        premises, and will be replaced with Amoke Oge’s own photography.
      </p>
      <ul class="credits__list">
        {list.map((p) => (
          <li>
            <span class="credits__alt">{p.alt}</span>
            <span>
              Photo by {p.credit!.author} ·{' '}
              <a href={p.credit!.licenseUrl} target="_blank" rel="noopener license">{p.credit!.license}</a> ·{' '}
              <a href={p.credit!.source} target="_blank" rel="noopener">Source</a>
            </span>
          </li>
        ))}
      </ul>
      <p class="credits__note">Images have been resized, cropped and lightly colour-adjusted for web use.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .credits { max-width: 860px; }
  .credits__list { list-style: none; padding: 0; margin-top: 2.5rem; border-top: 1px solid var(--line); }
  .credits__list li { display: grid; gap: 0.25rem; padding: 1rem 0; border-bottom: 1px solid var(--line); font-size: 0.9rem; color: var(--ink-muted); }
  .credits__alt { color: var(--charcoal); font-weight: 600; }
  .credits__list a { color: var(--forest-800); }
  .credits__note { margin-top: 1.5rem; font-size: 0.85rem; color: var(--ink-muted); }
</style>
