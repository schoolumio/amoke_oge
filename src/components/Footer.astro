---
import { site } from '../config/site';
import { branches, formatAddress } from '../data/branches';
import { whatsappUrl } from '../lib/whatsapp';
import Wordmark from './Wordmark.astro';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
---
<footer class="footer adire-bg">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <Wordmark tone="light" size="lg" />
        <p class="footer__about">
          Authentic Nigerian food in Lagos — hot amala with ewedu and gbegiri, rich soups, jollof, ofada and fried
          rice, yam porridge and more. Dine in, take away or order on WhatsApp.
        </p>
        <div class="footer__social">
          {site.socials.map((s) => (
            <a href={s.url} target="_blank" rel="noopener" class="footer__social-link">
              <Icon name="instagram" size={20} /> <span>{s.handle}</span>
            </a>
          ))}
        </div>
      </div>

      <nav class="footer__col" aria-label="Footer">
        <h2 class="footer__heading">Explore</h2>
        <ul>
          {site.nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          <li><a href="/#signature">Signature Dishes</a></li>
          <li><a href="/#gallery">Gallery</a></li>
        </ul>
      </nav>

      <div class="footer__col footer__branches">
        <h2 class="footer__heading">Our Branches</h2>
        <ul>
          {branches.map((b) => (
            <li>
              <a href={`/locations/${b.slug}`} class="footer__branch-name">{b.name}</a>
              <span>{formatAddress(b)}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="footer__col">
        <h2 class="footer__heading">Order &amp; Enquiries</h2>
        <p class="footer__contact-text">Send your order or ask for today’s menu and prices on WhatsApp.</p>
        <a href={whatsappUrl()} class="btn btn--light btn--sm" data-order-trigger target="_blank" rel="noopener">
          <Icon name="whatsapp" size={18} /> Order on WhatsApp
        </a>
        <p class="footer__partners">
          Delivery partners:
          {site.deliveryPartners.map((p, i) => (
            <>
              {p.url ? <a href={p.url} target="_blank" rel="noopener">{p.label}</a> : <span>{p.label}</span>}
              {i < site.deliveryPartners.length - 1 ? ' · ' : ''}
            </>
          ))}
        </p>
      </div>
    </div>

    <div class="footer__bottom">
      <p>© {year} {site.name}. All rights reserved.</p>
      <p class="footer__links">
        <a href="/photo-credits">Photo credits</a>
        {site.conceptMode && <span>Website concept — not yet the official site</span>}
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--forest-950);
    color: rgba(243, 236, 223, 0.72);
    padding-block: clamp(4rem, 3rem + 4vw, 6rem) 2rem;
    font-size: 0.92rem;
  }
  .footer a:not(.btn) { color: inherit; text-decoration: none; transition: color 0.25s; }
  .footer a:not(.btn):hover { color: var(--gold-soft); }
  .footer__top {
    display: grid;
    gap: 3rem 2.5rem;
    grid-template-columns: 1fr;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--line-light);
  }
  @media (min-width: 720px) { .footer__top { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1100px) { .footer__top { grid-template-columns: 1.5fr 0.8fr 1.3fr 1.1fr; } }
  .footer__brand :global(.wordmark) { font-size: 1.1rem; }
  .footer__about { margin-top: 1.5rem; max-width: 26rem; line-height: 1.7; }
  .footer__social { margin-top: 1.5rem; display: flex; gap: 1rem; }
  .footer__social-link { display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 600; color: var(--ivory) !important; }
  .footer__heading {
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold-soft);
    margin-bottom: 1.25rem;
  }
  .footer__col ul { list-style: none; padding: 0; display: grid; gap: 0.7rem; }
  .footer__branches li { display: grid; gap: 0.1rem; line-height: 1.5; }
  .footer__branch-name { color: var(--ivory) !important; font-weight: 600; }
  .footer__branches span { font-size: 0.85rem; }
  .footer__contact-text { margin-bottom: 1.25rem; max-width: 22rem; }
  .footer__partners { margin-top: 1.25rem; font-size: 0.82rem; }
  .footer__partners a { text-decoration: underline; text-underline-offset: 3px; }
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-top: 1.75rem;
    padding-bottom: 4.5rem;
    font-size: 0.8rem;
    color: rgba(243, 236, 223, 0.5);
  }
  @media (min-width: 768px) { .footer__bottom { padding-bottom: 0; } }
  .footer__links { display: flex; gap: 1.5rem; flex-wrap: wrap; }
</style>
