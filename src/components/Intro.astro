---
import { Image } from 'astro:assets';
import { photos, placeholder } from '../data/photos';
import Icon from './Icon.astro';

const main = photos.cookingFirewood;
const inset = photos.yorubaDelicacies;
---
<section class="section intro" id="story" aria-labelledby="story-title">
  <div class="container intro__grid">
    <div class="intro__text">
      <p class="eyebrow" data-reveal>Our Story</p>
      <h2 id="story-title" class="h2 intro__title" data-reveal style="--reveal-delay:80ms">
        Good Food. Rich Tradition. <em class="accent">Unforgettable Taste.</em>
      </h2>
      <div class="intro__copy" data-reveal style="--reveal-delay:160ms">
        <p class="intro__lead">
          Amoke Oge is a Lagos food destination built around the flavours of traditional Nigerian cooking.
        </p>
        <p>
          At the heart of the kitchen is the Yoruba classic — hot amala served with ewedu, gbegiri and a deep,
          peppery stew — alongside the rice dishes, soups and proteins Lagos enjoys every day.
        </p>
        <p>
          Every plate is about what matters at a Nigerian table: real flavour, satisfying portions and honest value.
          Walk in for a hot plate at one of our Lagos branches, pick up a pack on the go, or send your order on
          WhatsApp.
        </p>
      </div>

      <ul class="intro__pillars" data-reveal style="--reveal-delay:240ms">
        <li>
          <span class="intro__icon"><Icon name="flame" /></span>
          <span><strong>Yoruba classics</strong>Amala, ewedu, gbegiri &amp; ata dindin</span>
        </li>
        <li>
          <span class="intro__icon"><Icon name="bowl" /></span>
          <span><strong>Lagos favourites</strong>Jollof, fried rice, ofada &amp; asaro</span>
        </li>
        <li>
          <span class="intro__icon"><Icon name="bag" /></span>
          <span><strong>Ready to go</strong>Dine in or take away</span>
        </li>
      </ul>

      <p class="intro__welcome" data-reveal style="--reveal-delay:300ms">
        <span lang="yo">Ẹ káàbọ̀</span> — you are welcome.
      </p>
    </div>

    <div class="intro__visual" data-reveal style="--reveal-delay:120ms">
      <figure class="intro__main media">
        <Image
          src={main.src}
          alt={main.alt}
          widths={[480, 720, 960, 1200]}
          sizes="(min-width: 1024px) 40vw, 90vw"
          quality={70}
          style={placeholder(main)}
        />
      </figure>
      <figure class="intro__inset media">
        <Image
          src={inset.src}
          alt={inset.alt}
          widths={[320, 480, 640]}
          sizes="(min-width: 1024px) 18vw, 42vw"
          quality={70}
          style={placeholder(inset)}
        />
      </figure>
      <p class="intro__stamp" aria-hidden="true">Cooked<br /><em>the traditional way</em></p>
    </div>
  </div>
</section>

<style>
  .intro__grid { display: grid; gap: 3.5rem; align-items: center; }
  @media (min-width: 1024px) {
    .intro__grid { grid-template-columns: 1.05fr 1fr; gap: clamp(4rem, 7vw, 7.5rem); }
  }
  .intro__title { margin-top: 1.25rem; max-width: 14ch; }
  .intro__copy { margin-top: 2rem; display: grid; gap: 1.1rem; color: var(--ink-muted); max-width: 36rem; }
  .intro__lead {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.35;
    color: var(--charcoal);
    font-weight: 380;
  }
  .intro__pillars {
    list-style: none;
    padding: 0;
    margin-top: 2.5rem;
    display: grid;
    gap: 1.25rem;
    border-top: 1px solid var(--line);
    padding-top: 2rem;
  }
  @media (min-width: 640px) { .intro__pillars { grid-template-columns: repeat(3, 1fr); } }
  .intro__pillars li { display: flex; gap: 0.85rem; align-items: flex-start; font-size: 0.9rem; color: var(--ink-muted); line-height: 1.5; }
  .intro__pillars strong { display: block; color: var(--charcoal); font-size: 0.95rem; margin-bottom: 0.15rem; }
  .intro__icon {
    flex: none;
    display: grid; place-items: center;
    width: 44px; height: 44px;
    border-radius: 50%;
    border: 1px solid rgba(176, 77, 39, 0.3);
    color: var(--terracotta);
  }
  .intro__welcome {
    margin-top: 2.25rem;
    font-family: var(--font-display);
    font-size: var(--step-1);
    color: var(--forest-700);
  }
  .intro__welcome span { font-style: italic; color: var(--terracotta); }

  .intro__visual { position: relative; padding: 0 0 4.5rem 0; }
  .intro__main { aspect-ratio: 4 / 5; border-radius: var(--radius); margin-right: 12%; box-shadow: var(--shadow-md); }
  .intro__inset {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 46%;
    aspect-ratio: 3 / 4;
    border-radius: var(--radius);
    border: 6px solid var(--ivory);
    box-shadow: var(--shadow-lg);
  }
  .intro__stamp {
    position: absolute;
    left: -0.5rem;
    bottom: 1.25rem;
    padding: 1rem 1.25rem;
    background: var(--forest-900);
    color: var(--gold-soft);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    line-height: 1.6;
    border-radius: var(--radius);
  }
  .intro__stamp em {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    color: var(--ivory);
  }
  @media (min-width: 1024px) {
    .intro__stamp { left: -2rem; }
  }
</style>
