  </svg>
) : (
  <svg class={className} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" {...a11y}>
    {name === 'arrow-right' && <path d="M4 12h15m-5.5-6L19.5 12 13.5 18" />}
    {name === 'arrow-up-right' && <path d="M7 17 17 7M8.5 7H17v8.5" />}
    {name === 'menu' && <path d="M3.5 7.5h17M3.5 12h17M9.5 16.5h11" />}
    {name === 'close' && <path d="M6 6l12 12M18 6 6 18" />}
