    {name === 'branches' && (<><path d="M3.5 20.5h17M5 20.5V10l7-5.5 7 5.5v10.5" /><path d="M9.5 20.5v-5h5v5" /></>)}
    {name === 'plus' && <path d="M12 5v14M5 12h14" />}
    {name === 'minus' && <path d="M5 12h14" />}
    {name === 'chevron-left' && <path d="m14.5 6-6 6 6 6" />}
    {name === 'chevron-right' && <path d="m9.5 6 6 6-6 6" />}
    {name === 'check' && <path d="m5 12.5 4.5 4.5L19 7.5" />}
    {name === 'leaf' && (<><path d="M5 19c0-8 5-13 14-14-1 9-6 14-14 14Z" /><path d="M5 19 13 11" /></>)}
    {name === 'info' && (<><circle cx="12" cy="12" r="8.5" /><path d="M12 11v5M12 8h.01" /></>)}
