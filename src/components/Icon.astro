    {name === 'clock' && (<><circle cx="12" cy="12" r="8.5" /><path d="M12 7.5V12l3 2" /></>)}
    {name === 'directions' && (<><path d="M11.3 2.9a1 1 0 0 1 1.4 0l8.4 8.4a1 1 0 0 1 0 1.4l-8.4 8.4a1 1 0 0 1-1.4 0l-8.4-8.4a1 1 0 0 1 0-1.4Z" /><path d="M9 14v-2.2a1.3 1.3 0 0 1 1.3-1.3H15m-2-2 2 2-2 2" /></>)}
