    {name === 'bag' && (<><path d="M5 8.5h14l-1 11.2a1.5 1.5 0 0 1-1.5 1.3h-9A1.5 1.5 0 0 1 6 19.7L5 8.5Z" /><path d="M9 8.5V7a3 3 0 0 1 6 0v1.5" /></>)}
