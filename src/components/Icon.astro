---
/**
 * Refined line icon set (1.5px stroke, 24px grid).
 */
interface Props {
  name:
    | 'whatsapp' | 'arrow-right' | 'arrow-up-right' | 'menu' | 'close' | 'pin' | 'clock' | 'directions'
    | 'instagram' | 'bag' | 'flame' | 'bowl' | 'value' | 'branches' | 'plus' | 'minus' | 'chevron-left'
    | 'chevron-right' | 'check' | 'leaf' | 'info';
  size?: number;
  class?: string;
  label?: string;
}
const { name, size = 24, class: className, label } = Astro.props;
const a11y = label ? { role: 'img' as const, 'aria-label': label } : { 'aria-hidden': 'true' as const };
---
{name === 'whatsapp' ? (
