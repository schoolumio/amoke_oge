---
import { Image, getImage } from 'astro:assets';
import { gallery } from '../data/dishes';
import { placeholder, dimensions } from '../data/photos';
import { site } from '../config/site';
import Icon from './Icon.astro';

const items = await Promise.all(
  gallery.map(async (g) => {
    const { w, h } = dimensions(g.photo);
    // longest side at most 1400px so portrait photos stay small too
    const width = Math.round(w >= h ? Math.min(1400, w) : Math.min(1400, h) * (w / h));
    const full = await getImage({ src: g.photo.src, width, format: 'webp', quality: 56 });
    return { ...g, full: full.src };
  }),
);
const instagram = site.socials.find((s) => s.label === 'Instagram');
---
<section class="section section--cream gallery" id="gallery" aria-labelledby="gallery-title">
  <div class="container">
    <div class="section-head section-head--split">
      <div>
        <p class="eyebrow" data-reveal>Gallery</p>
        <h2 id="gallery-title" class="h2" data-reveal style="--reveal-delay:80ms">
          A feast <em class="accent">for the eyes</em>
        </h2>
      </div>
      <div class="gallery__intro" data-reveal style="--reveal-delay:160ms">
        <p class="lede">The colours, textures and comfort of the Nigerian table.</p>
        {instagram && (
          <a href={instagram.url} class="link-arrow" target="_blank" rel="noopener">
            <Icon name="instagram" size={18} /> Follow {instagram.handle}
          </a>
        )}
      </div>
    </div>

    <ul class="gallery__grid">
      {items.map((item, i) => (
        <li class:list={['gallery__item', item.size && `is-${item.size}`]} data-reveal style={`--reveal-delay:${(i % 4) * 70}ms`}>
          <button
            type="button"
            class="gallery__btn media zoom"
            data-lightbox-index={i}
            data-full={item.full}
            data-caption={item.caption}
            data-alt={item.photo.alt}
            data-credit={item.photo.credit ? `Photo: ${item.photo.credit.author} · ${item.photo.credit.license}` : ''}
            aria-label={`View larger: ${item.caption}`}
          >
            <Image
              src={item.photo.src}
              alt={item.photo.alt}
              width={960}
      widths={[320, 480, 720, 960]}
              sizes={item.size === 'large' || item.size === 'wide' ? '(min-width: 900px) 50vw, 100vw' : '(min-width: 900px) 25vw, 50vw'}
              quality={58}
              style={placeholder(item.photo)}
            />
            <span class="gallery__cap">{item.caption}</span>
          </button>
        </li>
      ))}
    </ul>

    {site.conceptMode && (
      <p class="gallery__disclaimer">
        <Icon name="info" size={16} />
        Demonstration photography of Nigerian dishes, used under Creative Commons licences. To be replaced with
        Amoke Oge’s own photography. <a href="/photo-credits">Photo credits</a>
      </p>
    )}
  </div>

  <dialog class="lightbox" aria-label="Photo viewer" data-lightbox>
    <figure class="lightbox__figure">
      <img alt="" data-lightbox-img decoding="async" />
      <figcaption>
        <span data-lightbox-caption></span>
        <small data-lightbox-credit></small>
      </figcaption>
    </figure>
    <button class="lightbox__btn lightbox__close" type="button" aria-label="Close" data-lightbox-close><Icon name="close" /></button>
    <button class="lightbox__btn lightbox__prev" type="button" aria-label="Previous photo" data-lightbox-prev><Icon name="chevron-left" /></button>
    <button class="lightbox__btn lightbox__next" type="button" aria-label="Next photo" data-lightbox-next><Icon name="chevron-right" /></button>
    <p class="lightbox__count" data-lightbox-count aria-live="polite"></p>
  </dialog>
</section>

<style>
  .gallery__intro { display: grid; gap: 1.25rem; justify-items: start; }
  .gallery__grid {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-auto-rows: clamp(150px, 42vw, 260px);
    grid-auto-flow: dense;
    gap: clamp(0.5rem, 1.2vw, 1rem);
  }
  @media (min-width: 900px) {
    .gallery__grid { grid-template-columns: repeat(4, 1fr); grid-auto-rows: clamp(180px, 17vw, 260px); }
    .is-large { grid-column: span 2; grid-row: span 2; }
    .is-wide { grid-column: span 2; }
  }
  .is-tall { grid-row: span 2; }
  @media (max-width: 899px) {
    .is-large, .is-wide { grid-column: span 2; }
    .is-large { grid-row: span 2; }
  }
  .gallery__item { min-width: 0; }
  .gallery__btn {
    width: 100%;
    height: 100%;
    padding: 0;
    border-radius: var(--radius);
    cursor: zoom-in;
  }
  .gallery__btn::after {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(0deg, rgba(10, 31, 21, 0.7) 0%, rgba(10, 31, 21, 0) 45%);
    opacity: 0;
    transition: opacity 0.5s var(--ease);
  }
  .gallery__cap {
    position: absolute;
    left: 1rem; right: 1rem; bottom: 0.9rem;
    z-index: 1;
    text-align: left;
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--ivory);
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.5s var(--ease), transform 0.5s var(--ease);
  }
  .gallery__btn:hover::after, .gallery__btn:focus-visible::after { opacity: 1; }
  .gallery__btn:hover .gallery__cap, .gallery__btn:focus-visible .gallery__cap { opacity: 1; transform: none; }
  @media (hover: none) {
    .gallery__btn::after { opacity: 0.85; }
    .gallery__cap { opacity: 1; transform: none; font-size: 0.85rem; left: 0.7rem; bottom: 0.6rem; }
  }
  .gallery__disclaimer {
    margin-top: 1.5rem;
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
    font-size: 0.8rem;
    color: var(--ink-muted);
  }
  .gallery__disclaimer :global(svg) { flex: none; margin-top: 2px; color: var(--terracotta); }
  .gallery__disclaimer a { color: var(--forest-800); font-weight: 600; }

  /* Lightbox */
  .lightbox {
    width: 100%; height: 100%;
    max-width: 100%; max-height: 100%;
    margin: 0; padding: 0; border: 0;
    background: rgba(8, 22, 15, 0.96);
    color: var(--cream);
    opacity: 0;
    transition: opacity 0.35s var(--ease);
  }
  .lightbox.is-open { opacity: 1; }
  .lightbox__figure {
    position: absolute;
    inset: 4.5rem 1rem 5rem;
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 1rem;
    justify-items: center;
  }
  @media (min-width: 900px) { .lightbox__figure { inset: 3rem 6rem 3rem; } }
  .lightbox__figure img { max-width: 100%; max-height: 100%; min-height: 0; object-fit: contain; border-radius: var(--radius); align-self: center; }
  .lightbox figcaption { text-align: center; display: grid; gap: 0.25rem; font-family: var(--font-display); font-size: 1.15rem; }
  .lightbox figcaption small { font-family: var(--font-body); font-size: 0.72rem; color: rgba(243, 236, 223, 0.55); }
  .lightbox__btn {
    position: absolute;
    display: grid; place-items: center;
    width: 52px; height: 52px;
    border-radius: 50%;
    color: var(--ivory);
    border: 1px solid var(--line-light);
    background: rgba(250, 246, 238, 0.04);
    transition: background-color 0.3s var(--ease);
  }
  .lightbox__btn:hover { background: rgba(250, 246, 238, 0.14); }
  .lightbox__close { top: 1rem; right: 1rem; }
  .lightbox__prev, .lightbox__next { bottom: 1rem; }
  .lightbox__prev { left: calc(50% - 64px); }
  .lightbox__next { right: calc(50% - 64px); }
  @media (min-width: 900px) {
    .lightbox__prev, .lightbox__next { bottom: auto; top: 50%; transform: translateY(-50%); }
    .lightbox__prev { left: 1.5rem; }
    .lightbox__next { right: 1.5rem; }
  }
  .lightbox__count { position: absolute; top: 1.6rem; left: 1.25rem; font-size: 0.8rem; letter-spacing: 0.15em; color: rgba(243, 236, 223, 0.6); }
</style>

<script>
  const box = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-lightbox-index]')];
  if (box && buttons.length && typeof box.showModal === 'function') {
    const img = box.querySelector<HTMLImageElement>('[data-lightbox-img]')!;
    const cap = box.querySelector<HTMLElement>('[data-lightbox-caption]')!;
    const credit = box.querySelector<HTMLElement>('[data-lightbox-credit]')!;
    const count = box.querySelector<HTMLElement>('[data-lightbox-count]')!;
    let index = 0;
    let opener: HTMLElement | null = null;

    const show = (i: number) => {
      index = (i + buttons.length) % buttons.length;
      const b = buttons[index];
      img.src = b.dataset.full!;
      img.alt = b.dataset.alt ?? '';
      cap.textContent = b.dataset.caption ?? '';
      credit.textContent = b.dataset.credit ?? '';
      count.textContent = `${String(index + 1).padStart(2, '0')} / ${String(buttons.length).padStart(2, '0')}`;
    };
    const close = () => {
      box.classList.remove('is-open');
      document.documentElement.style.overflow = '';
      setTimeout(() => { box.close(); opener?.focus({ preventScroll: true }); }, 250);
    };
    buttons.forEach((b, i) =>
      b.addEventListener('click', () => {
        opener = b;
        show(i);
        box.showModal();
        document.documentElement.style.overflow = 'hidden';
        requestAnimationFrame(() => box.classList.add('is-open'));
      }),
    );
    box.querySelector('[data-lightbox-close]')!.addEventListener('click', close);
    box.querySelector('[data-lightbox-prev]')!.addEventListener('click', () => show(index - 1));
    box.querySelector('[data-lightbox-next]')!.addEventListener('click', () => show(index + 1));
    box.addEventListener('cancel', (e) => { e.preventDefault(); close(); });
    box.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(index + 1);
      if (e.key === 'ArrowLeft') show(index - 1);
    });
    box.addEventListener('click', (e) => { if (e.target === box) close(); });
    let startX = 0;
    box.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; }, { passive: true });
    box.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
    });
  }
</script>
