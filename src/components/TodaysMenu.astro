---
import { Image } from 'astro:assets';
import { todaysMenu, naira, priceLabel, updatedLabel } from '../data/todays-menu';
import { placeholder } from '../data/photos';
import { whatsappUrl, dishMessage } from '../lib/whatsapp';
import { site } from '../config/site';
import Icon from './Icon.astro';

const all = todaysMenu.groups.flatMap((g) => g.items);
const availableCount = all.filter((i) => i.available).length + todaysMenu.deals.filter((d) => d.available).length;
const totalCount = all.length + todaysMenu.deals.length;
const updated = updatedLabel();
---
<section class="section today" id="today" aria-labelledby="today-title">
  <div class="container">
    <div class="today__head">
      <div>
        <p class="eyebrow" data-reveal>Today’s Menu</p>
        <h2 id="today-title" class="h2" data-reveal style="--reveal-delay:80ms">
          What’s cooking <em class="accent">today</em>
        </h2>
        <p class="lede" data-reveal style="--reveal-delay:160ms">
          See what’s available and what it costs before you come — then order on WhatsApp in one tap.
        </p>
      </div>

      <div class="today__status" data-reveal style="--reveal-delay:200ms">
        <p class="today__live"><span class="today__dot" aria-hidden="true"></span> {availableCount} of {totalCount} dishes available</p>
        <p class="today__updated">
          <Icon name="clock" size={16} /> Updated <time datetime={todaysMenu.updated}>{updated}</time> · {todaysMenu.branch}
        </p>
        <label class="switch">
          <input type="checkbox" id="today-available-only" />
          <span class="switch__track" aria-hidden="true"><span class="switch__thumb"></span></span>
          <span>Show available only</span>
        </label>
      </div>
    </div>

    <h3 class="today__sub" data-reveal>Meal deals</h3>
    <ul class="deals" data-reveal>
      {todaysMenu.deals.map((d) => (
        <li class:list={['deal', { 'is-soldout': !d.available }]}>
          <figure class="deal__media media zoom">
            <Image src={d.photo.src} alt={d.photo.alt} width={640} widths={[320, 480, 640]} sizes="(min-width: 1024px) 23vw, (min-width: 640px) 45vw, 78vw" quality={62} style={placeholder(d.photo)} />
            <span class="deal__price">{naira(d.price!)}</span>
          </figure>
          <div class="deal__body">
            <h4 class="deal__name">{d.name}</h4>
            <p class="deal__desc">{d.description}</p>
            {d.available ? (
              <a
                href={whatsappUrl(dishMessage(d.name, null, naira(d.price!)))}
                class="btn btn--forest btn--sm deal__btn"
                data-order-trigger
                data-dish={d.name}
                data-price={d.price}
                target="_blank"
                rel="noopener"
              >
                <Icon name="whatsapp" size={18} /> Order this deal
              </a>
            ) : (
              <span class="soldout-pill">Sold out today</span>
            )}
          </div>
        </li>
      ))}
    </ul>

    <div class="board">
      {todaysMenu.groups.map((g, gi) => (
        <section class="board__group" aria-labelledby={`today-${g.id}`} data-reveal style={`--reveal-delay:${(gi % 2) * 80}ms`}>
          <h3 id={`today-${g.id}`} class="board__title">{g.title}</h3>
          <ul class="board__list">
            {g.items.map((item) => (
              <li class:list={['board__row', { 'is-soldout': !item.available }]}>
                <span class="board__thumb">
                  <Image src={item.photo.src} alt="" width={128} widths={[64, 128]} sizes="56px" quality={60} style={placeholder(item.photo)} />
                </span>
                <span class="board__name">
                  {item.name}
                  {item.unit && <small>{item.unit}</small>}
                </span>
                <span class:list={['board__price', { 'is-note': item.price === null }]}>{priceLabel(item)}</span>
                {item.available ? (
                  <a
                    href={whatsappUrl(dishMessage(item.name, null, item.price ? naira(item.price) : undefined))}
                    class="board__add"
                    data-order-trigger
                    data-dish={item.name}
                    data-price={item.price ?? undefined}
                    target="_blank"
                    rel="noopener"
                    aria-label={`Add ${item.name} to your WhatsApp order`}
                  >
                    <Icon name="plus" size={18} />
                  </a>
                ) : (
                  <span class="soldout-pill">Sold out</span>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <div class="today__foot" data-reveal>
      <p class="today__packs"><Icon name="bag" size={18} /> {todaysMenu.packs}</p>
      <p class="today__source">
        Prices and availability as listed on <a href={todaysMenu.source.url} target="_blank" rel="noopener">{todaysMenu.source.label}</a> ({todaysMenu.branch}) on {updated}.
        Walk-in prices and availability can differ by branch and time of day.
        {site.conceptMode && ' Demo snapshot — to be maintained by Amoke Oge staff.'}
      </p>
    </div>
  </div>
</section>

<style>
  .today { background: var(--cream); }
  .today__head { display: grid; gap: 2rem; align-items: end; margin-bottom: clamp(2.5rem, 4vw, 3.5rem); }
  @media (min-width: 900px) { .today__head { grid-template-columns: 1.3fr 1fr; gap: 4rem; } }
  .today__head .h2 { margin-top: 1.1rem; }
  .today__head .lede { margin-top: 1.1rem; }

  .today__status {
    display: grid;
    gap: 0.75rem;
    padding: 1.25rem 1.4rem;
    background: var(--ivory);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .today__live { display: flex; align-items: center; gap: 0.6rem; font-weight: 700; color: var(--forest-800); }
  .today__dot {
    width: 10px; height: 10px; border-radius: 50%;
    background: #1faa55;
    box-shadow: 0 0 0 0 rgba(31, 170, 85, 0.5);
    animation: pulse 2.2s infinite;
  }
  @keyframes pulse { 70% { box-shadow: 0 0 0 9px rgba(31, 170, 85, 0); } 100% { box-shadow: 0 0 0 0 rgba(31, 170, 85, 0); } }
  .today__updated { display: flex; align-items: center; gap: 0.45rem; font-size: 0.85rem; color: var(--ink-muted); }

  .switch { display: inline-flex; align-items: center; gap: 0.7rem; cursor: pointer; font-size: 0.9rem; font-weight: 600; min-height: 44px; }
  .switch input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .switch__track {
    position: relative;
    width: 44px; height: 26px; flex: none;
    border-radius: 999px;
    background: var(--sand-deep);
    transition: background-color 0.3s var(--ease);
  }
  .switch__thumb {
    position: absolute; top: 3px; left: 3px;
    width: 20px; height: 20px; border-radius: 50%;
    background: #fff;
    box-shadow: var(--shadow-sm);
    transition: transform 0.3s var(--ease);
  }
  .switch input:checked + .switch__track { background: var(--forest-700); }
  .switch input:checked + .switch__track .switch__thumb { transform: translateX(18px); }
  .switch input:focus-visible + .switch__track { outline: 2px solid var(--gold); outline-offset: 2px; }

  /* "Available only" — pure CSS, works without JavaScript */
  .today:has(#today-available-only:checked) .is-soldout { display: none; }

  .today__sub {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--forest-800);
    margin-bottom: 1rem;
  }

  /* Deals */
  .deals {
    list-style: none;
    padding: 0 0 0.5rem;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(78vw, 300px);
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
    scroll-padding-inline: var(--gutter);
  }
  .deals::-webkit-scrollbar { display: none; }
  @media (min-width: 1024px) {
    .deals { grid-auto-flow: row; grid-template-columns: repeat(4, 1fr); overflow: visible; margin-inline: 0; padding-inline: 0; }
  }
  .deal {
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    background: var(--ivory);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: box-shadow 0.4s var(--ease), transform 0.4s var(--ease);
  }
  .deal:hover { box-shadow: var(--shadow-md); transform: translateY(-3px); }
  .deal__media { aspect-ratio: 4 / 3; }
  .deal__price {
    position: absolute;
    left: 0.85rem; bottom: 0.85rem;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    background: var(--terracotta);
    color: var(--ivory);
    font-family: var(--font-display);
    font-size: 1.35rem;
    line-height: 1.2;
    box-shadow: var(--shadow-md);
  }
  .deal__body { padding: 1.1rem 1.15rem 1.25rem; display: flex; flex-direction: column; gap: 0.5rem; flex: 1; }
  .deal__name { font-size: var(--step-1); }
  .deal__desc { font-size: 0.86rem; color: var(--ink-muted); line-height: 1.5; }
  .deal__btn { margin-top: auto; align-self: flex-start; }

  /* Board */
  .board { margin-top: clamp(2.5rem, 4vw, 3.5rem); display: grid; gap: 1.25rem; }
  @media (min-width: 900px) { .board { grid-template-columns: 1fr 1fr; gap: 1.5rem; align-items: start; } }
  .board__group {
    background: var(--ivory);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 1.25rem clamp(1rem, 2.5vw, 1.6rem) 0.5rem;
  }
  .board__title { font-size: var(--step-2); padding-bottom: 0.75rem; border-bottom: 2px solid var(--forest-800); }
  .board__list { list-style: none; padding: 0; }
  .board__row {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) auto auto;
    align-items: center;
    gap: clamp(0.55rem, 2vw, 0.85rem);
    padding: 0.7rem 0;
    border-bottom: 1px dashed var(--sand-deep);
  }
  .board__row:last-child { border-bottom: 0; }
  .board__thumb { width: 56px; height: 56px; border-radius: var(--radius); overflow: hidden; background: var(--sand); }
  .board__thumb :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .board__name { font-weight: 600; color: var(--charcoal); line-height: 1.3; display: grid; gap: 0.1rem; }
  .board__name small { font-weight: 500; font-size: 0.78rem; color: var(--ink-muted); }
  .board__price { font-family: var(--font-display); font-size: 1.15rem; color: var(--forest-800); white-space: nowrap; }
  .board__price.is-note { font-family: var(--font-body); font-size: 0.78rem; font-weight: 700; color: #1a7f45; white-space: normal; text-align: right; max-width: 6.5rem; }
  .board__add {
    display: grid; place-items: center;
    width: 40px; height: 40px;
    border-radius: 50%;
    background: var(--forest-800);
    color: var(--ivory);
    transition: background-color 0.3s var(--ease), transform 0.3s var(--ease);
  }
  .board__add:hover { background: var(--terracotta); transform: scale(1.06); }
  .soldout-pill {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
    background: var(--sand);
    border-radius: 999px;
    padding: 0.3rem 0.6rem;
    white-space: nowrap;
  }
  .board__row.is-soldout .board__thumb :global(img) { filter: grayscale(1); opacity: 0.55; }
  .board__row.is-soldout .board__name, .board__row.is-soldout .board__price { opacity: 0.55; }
  .board__row.is-soldout .board__price { text-decoration: line-through; text-decoration-thickness: 1px; }
  .deal.is-soldout { opacity: 0.6; }
  @media (max-width: 359px) {
    .board__row { grid-template-columns: 48px minmax(0, 1fr) auto; }
    .board__thumb { width: 48px; height: 48px; }
    .board__row > :last-child { grid-column: 3; }
    .board__price { grid-column: 3; grid-row: 1; justify-self: end; align-self: end; }
    .board__row > .board__add, .board__row > .soldout-pill { grid-row: 2; justify-self: end; }
    .board__thumb { grid-row: 1 / span 2; }
    .board__name { grid-row: 1 / span 2; }
  }

  .today__foot {
    margin-top: 1.5rem;
    display: grid;
    gap: 0.6rem;
    font-size: 0.85rem;
    color: var(--ink-muted);
  }
  .today__packs { display: flex; gap: 0.5rem; align-items: flex-start; }
  .today__foot :global(svg) { flex: none; color: var(--terracotta); margin-top: 1px; }
  @media (max-width: 480px) {
    .board__thumb { width: 48px; height: 48px; }
    .board__row { grid-template-columns: 48px minmax(0, 1fr) auto auto; }
    .board__price { font-size: 1.02rem; }
    .soldout-pill { font-size: 0.62rem; padding: 0.25rem 0.5rem; }
  }
  .today__source a { color: var(--forest-800); font-weight: 600; }
</style>
